# Douyin Knowledge - example configuration.
# Copy to .env and edit. .env is gitignored and MUST NOT be committed.
# Every variable is optional: with none set, the app runs in credential-free
# demo mode using fixture capture and fake AI providers.

# ---------------------------------------------------------------- paths
# Root for the SQLite database, media cache, evidence artifacts, vectors, logs.
DK_DATA_DIR=./data

# ---------------------------------------------------------------- server
DK_API_HOST=127.0.0.1
DK_API_PORT=8787
DK_LOG_LEVEL=INFO
DK_LOG_FORMAT=text

# ---------------------------------------------------------------- capture
# fixture = bundled demo collection, no credentials, works offline.
# douyin  = talk to the Douyin_TikTok_Download_API sidecar over HTTP.
DK_CAPTURE_PROVIDER=fixture
DK_DOUYIN_SIDECAR_URL=http://127.0.0.1:8000
# Only if your sidecar deployment requires it. Douyin cookies/session belong in
# the sidecar's own configuration, NOT here and NOT in the SQLite database.
# DK_DOUYIN_SIDECAR_API_KEY=

# ---------------------------------------------------------------- ai providers
# fake = deterministic offline stand-ins (tests and demo mode).
# openai / openai_compatible = real HTTP models.
DK_LLM_PROVIDER=fake
DK_EMBEDDING_PROVIDER=fake
DK_ASR_PROVIDER=fake
DK_OCR_PROVIDER=fake
DK_VISION_PROVIDER=fake

# DK_OPENAI_API_KEY=sk-your-key-here
# DK_OPENAI_BASE_URL=https://api.openai.com/v1

# Per-role model names. Cheap models for triage/planning, stronger for extraction.
# DK_TRIAGE_MODEL=gpt-4o-mini
# DK_EXTRACTION_MODEL=gpt-4o
# DK_QUERY_PLANNER_MODEL=gpt-4o-mini
# DK_ANSWER_MODEL=gpt-4o
# DK_WIKI_ROUTER_MODEL=gpt-4o-mini
# DK_WIKI_INTEGRATION_MODEL=gpt-4o
# DK_VISION_MODEL=gpt-4o
# DK_EMBEDDING_MODEL=text-embedding-3-small
# DK_EMBEDDING_DIM=1536
# DK_ASR_MODEL=whisper-1

# ---------------------------------------------------------------- processing
# Processing ladder: 0 metadata / 1 text / 2 ASR / 3 keyframes+OCR / 4 deep multimodal
DK_DEFAULT_DESIRED_LEVEL=2
DK_MAX_PROCESSING_LEVEL=3
DK_MEDIA_RETENTION=cache

# ---------------------------------------------------------------- retrieval
# numpy = zero extra dependencies. lancedb = install with the "lancedb" extra.
DK_VECTOR_BACKEND=numpy
DK_PERSONAL_FIRST=true

# ---------------------------------------------------------------- worker
DK_WORKER_POLL_INTERVAL_S=1.0
DK_JOB_MAX_ATTEMPTS=3
