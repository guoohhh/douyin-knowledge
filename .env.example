# Douyin Knowledge - example configuration.
#
# Copy to .env and edit:  cp .env.example .env
# .env is gitignored and MUST NOT be committed. Neither must Douyin cookies, session
# tokens, API keys, or any real collection data (SEC-001).
#
# Every variable below is optional and shown with its real default. With none of them
# set the app runs in credential-free demo mode: bundled fixture collection, mock AI
# providers, no network calls. Demo mode is a supported mode, not a stub.
#
# Values are validated on startup, so an unknown value fails loudly rather than being
# silently ignored. Provider fields accept exactly `mock` or `openai`.

# ---------------------------------------------------------------- paths
# Root for the SQLite database, media cache, evidence artifacts, vectors, exports, logs.
DK_DATA_DIR=./data
# Overrides the SQLite path entirely. Leave unset to use DK_DATA_DIR/app.db.
# DK_DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------- server
DK_API_HOST=127.0.0.1
DK_API_PORT=8787
# Loopback only by design: this service exposes a personal knowledge base and, with a
# real key configured, a path to a paid API. It must not be reachable from an arbitrary
# page the browser happens to have open. Only widen this if you know why you are doing it.
# DK_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DK_SERVE_FRONTEND=true
DK_LOG_LEVEL=INFO
DK_LOG_FORMAT=text

# ---------------------------------------------------------------- sqlite
DK_SQLITE_JOURNAL_MODE=WAL
DK_SQLITE_SYNCHRONOUS=NORMAL
DK_SQLITE_BUSY_TIMEOUT_MS=5000
DK_SQL_ECHO=false

# ---------------------------------------------------------------- capture
# fixture = bundled demo collection, no credentials, works offline.
# douyin  = talk to the Douyin_TikTok_Download_API sidecar over HTTP.
DK_CAPTURE_PROVIDER=fixture
DK_DOUYIN_SIDECAR_URL=http://127.0.0.1:8000
DK_DOUYIN_SIDECAR_TIMEOUT_S=30.0
# Only if your sidecar deployment requires it. Your Douyin cookies and session belong in
# the sidecar's own configuration -- never here, and never in the SQLite database.
# DK_DOUYIN_SIDECAR_API_KEY=
# DK_CAPTURE_FIXTURE_DIR=

# ---------------------------------------------------------------- ai providers
# One provider for everything, with optional per-capability overrides. Unset overrides
# inherit DK_AI_PROVIDER, so `openai` here is enough to switch the whole system over.
DK_AI_PROVIDER=mock
# DK_EMBEDDING_PROVIDER=mock
# DK_ASR_PROVIDER=mock
# DK_OCR_PROVIDER=mock

# DK_OPENAI_API_KEY=sk-your-key-here
# DK_OPENAI_BASE_URL=https://api.openai.com/v1
# DK_OPENAI_TIMEOUT_S=120.0
# DK_OPENAI_CHAT_MODEL=gpt-4o-mini
# DK_OPENAI_VISION_MODEL=gpt-4o
# DK_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- model roles
# Per-role overrides. Left unset, each role's model name is derived from the active
# provider, which keeps `processing_runs.models_json` honest: the recorded name is the
# one actually called. Set these to spend less on triage than on extraction.
# DK_TRIAGE_MODEL=gpt-4o-mini
# DK_EXTRACTION_MODEL=gpt-4o
# DK_QUERY_PLANNER_MODEL=gpt-4o-mini
# DK_ANSWER_MODEL=gpt-4o
# DK_WIKI_ROUTER_MODEL=gpt-4o-mini
# DK_WIKI_INTEGRATION_MODEL=gpt-4o
# DK_VISION_MODEL=gpt-4o
# DK_ASR_MODEL=whisper-1
# DK_OCR_MODEL=gpt-4o
# DK_EMBEDDING_MODEL=text-embedding-3-small

# Must match the embedding model's real dimensionality. The default suits the mock
# provider; text-embedding-3-small is 1536. Changing this invalidates the existing
# vector index, so run `dk reindex` afterwards.
DK_EMBEDDING_DIM=256

# ---------------------------------------------------------------- processing
# Ladder: 0 metadata / 1 text / 2 ASR / 3 keyframes+OCR / 4 deep multimodal.
# `desired` is what a normal sync aims for; `max` is the ceiling a rule or an explicit
# request may raise it to.
DK_DEFAULT_DESIRED_LEVEL=2
DK_MAX_PROCESSING_LEVEL=3
# cache = delete downloaded media once evidence is extracted. retained = keep the files.
DK_MEDIA_RETENTION=cache

# ---------------------------------------------------------------- worker
DK_WORKER_POLL_INTERVAL_S=1.0
DK_WORKER_LEASE_TTL_S=600
DK_JOB_MAX_ATTEMPTS=3
DK_JOB_BACKOFF_BASE_S=5.0
DK_JOB_BACKOFF_MAX_S=900.0

# ---------------------------------------------------------------- retrieval
# numpy = zero extra dependencies. lancedb = install with the "lancedb" extra.
DK_VECTOR_BACKEND=numpy
# unicode61 does not split Chinese on its own, so CJK text is pre-segmented with jieba.
# Turning this off will quietly cost you most of your Chinese keyword recall.
DK_FTS_TOKENIZER=unicode61
DK_FTS_SEGMENT_CJK=true
DK_RETRIEVAL_CANDIDATE_LIMIT=40
DK_RETRIEVAL_PER_SURFACE_LIMIT=25
DK_RETRIEVAL_MAX_PER_SOURCE=3
DK_RETRIEVAL_EVIDENCE_BUDGET=24
# Answer from your own collection first, and say so when it has nothing (RET-002).
DK_PERSONAL_FIRST=true
DK_ENABLE_QUERY_ENRICHMENT=true

# ---------------------------------------------------------------- wiki
DK_WIKI_ROUTE_CANDIDATE_LIMIT=8
DK_WIKI_QUALITY_CLOSE_THRESHOLD=3
